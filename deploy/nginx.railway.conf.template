# Same routing as deploy/nginx.conf, but for the single-container Railway image (deploy/railway.Dockerfile):
# the API runs in the same container, so it's reached over localhost instead of the "api" compose hostname,
# and the listen port is substituted at start time from Railway's $PORT (deploy/railway-start.sh).
map $http_cf_connecting_ip $client_ip {
  ""      $proxy_add_x_forwarded_for;
  default $http_cf_connecting_ip;
}

server {
  listen __PORT__;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 3m;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location /api/ {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $client_ip;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location / {
    add_header Cache-Control "no-store";
    try_files $uri /index.html;
  }
}
