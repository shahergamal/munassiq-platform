NODE_ENV=development
PORT=4000
# Tenant traffic: RLS enforced (role munassiq_app)
DATABASE_URL=postgres://munassiq_app:change-me-app@localhost:5432/munassiq
# Auth / provisioning / platform admin (role munassiq_system, BYPASSRLS)
SYSTEM_DATABASE_URL=postgres://munassiq_system:change-me-system@localhost:5432/munassiq
# Migrations only (table owner)
MIGRATE_DATABASE_URL=postgres://munassiq_owner:change-me-owner@localhost:5432/munassiq
# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
APP_URL=http://localhost:5173
COOKIE_SECURE=false
# Leave empty in development: emails are printed to the console.
SMTP_URL=
MAIL_FROM="مُنَسِّق <no-reply@munassiq.example>"

# AI assistant (optional). Without a key the assistant shows "not configured".
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_DAILY_TURNS=50
# Requests per minute from one IP (all routes). A team behind one office IP shares it: raise for larger teams.
RATE_LIMIT_PER_MINUTE=300
# Platform admins must turn on two-step sign-in (default: true in production).
# ADMIN_MFA_REQUIRED=true
# Encrypts each workspace's ZATCA device private key and CSID secrets, and its payment gateway keys (Moyasar/Tap)
# (AES-256-GCM). Defaults to SESSION_SECRET. Set it once and keep it: changing it means every workspace must onboard
# its device again and reconnect its payment gateways.
# ZATCA_KEY_SECRET=

# Platform billing (optional): the PLATFORM's own Moyasar secret key. Workspaces pay subscriptions and extra
# storage to it from "الاشتراك والفوترة". Empty = online payment for subscriptions is off.
PLATFORM_MOYASAR_SECRET_KEY=

# Admin "الخادم والحماية" screen (each feature stays off until its variables are set):
# Cloudflare: API token with Zone.Cache Purge + Zone.Firewall Services (Edit), and the zone id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# "نشر التحديث": the deploy webhook of the hosting platform (Coolify / Railway / Render) and its token.
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TOKEN=
# Only if something starts the server again after it stops (Docker restart policy, PM2, systemd, the platform).
SERVER_RESTART_ENABLED=false
